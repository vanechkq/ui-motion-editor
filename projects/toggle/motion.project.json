{
  "schema": 1,
  "name": "focus-toggle",
  "label": "Переключатель",
  "composition": {
    "width": 360,
    "height": 360,
    "fps": 60,
    "exportScale": 1
  },
  "scene": "./index.html",
  "timeline": "./timeline.mjs",
  "editor": {
    "groups": [
      {
        "id": "motion",
        "label": "Движение",
        "fields": [
          {
            "path": "hold.active",
            "label": "Включён",
            "type": "number",
            "min": 0,
            "max": 30,
            "step": 0.1,
            "unit": "с"
          },
          {
            "path": "motion.slide",
            "label": "Сдвиг",
            "type": "preset",
            "options": [
              {
                "label": "Мягкое",
                "value": {
                  "omega": 24,
                  "zeta": 0.74,
                  "duration": 0.5
                }
              },
              {
                "label": "Текущее",
                "value": {
                  "omega": 28,
                  "zeta": 0.86,
                  "duration": 0.42
                }
              },
              {
                "label": "Быстрое",
                "value": {
                  "omega": 34,
                  "zeta": 0.88,
                  "duration": 0.34
                }
              }
            ]
          }
        ]
      },
      {
        "id": "content",
        "label": "Текст",
        "fields": [
          {
            "path": "content.title",
            "label": "Заголовок",
            "type": "textarea",
            "rows": 3
          }
        ]
      }
    ]
  },
  "loop": true
}
